{
  "xsappname": "sap-datasphere-mcp",
  "tenant-mode": "dedicated",
  "description": "Login for the SAP Datasphere MCP server (principal propagation)",
  "scopes": [],
  "role-templates": [],
  "oauth2-configuration": {
    "grant-types": ["authorization_code", "refresh_token"],
