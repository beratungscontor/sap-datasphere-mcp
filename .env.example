# SAP Datasphere MCP Server Configuration

# SAP Datasphere Connection
DATASPHERE_BASE_URL=https://your-tenant.eu10.hcs.cloud.sap
DATASPHERE_TENANT_ID=your-tenant-id

# OAuth 2.0 Credentials (Technical User)
# Create these in your SAP Datasphere App Integration settings
DATASPHERE_CLIENT_ID=your-client-id
DATASPHERE_CLIENT_SECRET=your-client-secret
DATASPHERE_TOKEN_URL=https://your-tenant.authentication.eu10.hana.ondemand.com/oauth/token

# Optional: OAuth Scope (leave empty for default)
DATASPHERE_SCOPE=

# Server Configuration
LOG_LEVEL=INFO
SERVER_PORT=8080

# Development Mode (set to false for production)
USE_MOCK_DATA=false

# ---------------------------------------------------------------------------
# Authentication mode
#   service   (default) one technical user via the client credentials above
#   principal each caller's own Datasphere permissions (SAML bearer assertion
#             via BTP Destination service). Requires --transport http.
#             Setup: docs/OAUTH_SETUP.md (Part 2)
# ---------------------------------------------------------------------------
DATASPHERE_AUTH_MODE=service

# Only used when DATASPHERE_AUTH_MODE=principal (values from the BTP service keys)
# XSUAA service key: "url" and "clientid"
XSUAA_URL=https://your-subaccount.authentication.eu10.hana.ondemand.com
XSUAA_CLIENT_ID=
# Destination service key: "url" (token host), "uri" (configuration API), clientid/secret
DESTINATION_SERVICE_URL=https://your-subaccount.authentication.eu10.hana.ondemand.com
DESTINATION_SERVICE_URI=https://destination-configuration.cfapps.eu10.hana.ondemand.com
DESTINATION_CLIENT_ID=
DESTINATION_CLIENT_SECRET=
DESTINATION_NAME=Datasphere_Token_Exchange_MCP
# IAS group Datasphere requires in the assertion, and the token claim holding the user id
PP_REQUIRED_GROUP=sac
PP_USER_CLAIM=user_name
# OAuth discovery (RFC 9728), optional. Public URL of this server; on Cloud Foundry the
# app route is detected automatically. Set it for custom domains / reverse proxies.
MCP_PUBLIC_URL=
# Authorization server advertised to clients (default: XSUAA_URL)
MCP_AUTHORIZATION_SERVER=
